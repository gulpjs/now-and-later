    "eslint-plugin-node": "^11.1.0",
    "expect": "^27.4.2",
    "mocha": "^8.4.0",
    "nyc": "^15.1.0",
    "prettier": "3.9.6"
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "keywords": [
    "async",
    "parallel",
    "series",
    "each",
    "async.js",
    "map",
    "control",
    "flow",
    "extension",
