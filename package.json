{
  "name": "now-and-later",
  "version": "3.0.0",
  "description": "Map over an array or object of values in parallel or series, passing each through the async iterator, with optional lifecycle hooks.",
  "author": "Gulp Team <team@gulpjs.com> (http://gulpjs.com/)",
  "contributors": [
    "Blaine Bublitz <blaine.bublitz@gmail.com>"
  ],
  "funding": "https://github.com/sponsors/gulpjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulpjs/now-and-later.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22.15.0"
  },
  "main": "./index.js",
  "files": [
    "index.js",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "format-check": "prettier . --check",
    "format-write": "prettier . --write",
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "nyc mocha --async-only"
  },
  "dependencies": {
    "once": "^1.4.0"
  },
  "devDependencies": {
    "eslint": "10.11.0",
